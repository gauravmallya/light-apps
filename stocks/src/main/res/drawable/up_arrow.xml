<?xml version="1.0" encoding="utf-8"?><!--
    UP ARROW — visible shaft (line) connected to a filled arrowhead.

    NOTE: Android requires resource filenames to be lowercase (a-z, 0-9, _), so a
    file named `UpArrow` isn't allowed by the build. This file is `up_arrow.xml`
    and is referenced in code as `R.drawable.up_arrow`. Please edit this file to
    replace the path data / colors with your own design. It renders in the theme's
    content color at runtime via the stocks UI.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="30.0dp"
    android:height="30.0dp"
    android:viewportWidth="30.0"
    android:viewportHeight="30.0">
    <!-- Up arrow: vertical line (shaft) + filled upward chevron (head) -->
    <path
        android:pathData="M 14.0,26.5 L 14.0,11.5 L 8.0,18.0 L 6.0,16.0 L 15.0,7.0 L 24.0,16.0 L 22.0,18.0 L 16.0,11.5 L 16.0,26.5 Z"
        android:fillColor="#FFFFFFFF" />
</vector>